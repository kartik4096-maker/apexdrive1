generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id     Int      @id @default(autoincrement())
  name   String   @unique
  cars   CarCity[]
}

model Car {
  id           String     @id
  name         String
  brand        String
  type         String
  fuel         String
  transmission String
  seats        Int
  bags         Int
  dailyPricePaise Int
  mileage      String
  engine       String
  description  String
  badge        String
  badgeIcon    String
  badgeTag     String?
  image        String
  fallback     String
  features     String[]
  cities       CarCity[]
  reviews      Review[]
  bookings     Booking[]
  savedBy      SavedCar[]
  createdAt    DateTime   @default(now())
}

model CarCity {
  carId  String
  cityId Int
  car    Car  @relation(fields: [carId], references: [id], onDelete: Cascade)
  city   City @relation(fields: [cityId], references: [id], onDelete: Cascade)
  @@id([carId, cityId])
  @@index([cityId])
}

model Review {
  id        String   @id @default(cuid())
  carId     String
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  name      String
  rating    Int
  text      String
  createdAt DateTime @default(now())
  @@index([carId])
}

model Booking {
  id           String   @id @default(cuid())
  reference    String   @unique
  carId        String
  car          Car      @relation(fields: [carId], references: [id])
  cityName     String
  clientId     String
  name         String
  phone        String
  email        String
  startAt      DateTime
  endAt        DateTime
  days         Int
  subtotalPaise Int
  gstPaise     Int
  totalPaise   Int
  status       String   @default("confirmed")
  createdAt    DateTime @default(now())
  @@index([carId, startAt, endAt])
  @@index([phone])
}

model SavedCar {
  clientId String
  carId    String
  car      Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
  @@id([clientId, carId])
}